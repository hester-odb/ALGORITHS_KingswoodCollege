# ==========================================
# EcoSpark Innovations - .gitignore
# ==========================================

# Dependencies
node_modules/
jspm_packages/
.pnp
.pnp.js

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Environment & Sensitive Config
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Editor & IDE Configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Temporary / Scratch Files
tmp/
temp/
*.tmp
*.temp
.cache/

# Testing & Coverage
coverage/
.nyc_output/
.pytest_cache/

# Keep seed data tracked
!backend/src/data/*.json
